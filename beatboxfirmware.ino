const uint32_t special_len = sizeof(special_effect_data)/sizeof(special_effect_data[0]);

//end of sounds

const uint32_t sample_freq = 22050; // all samples are 22050 Hz
const uint8_t max_voice = 5;
const uint8_t master_vol = 50; // audio base set at 50
const float velocity_curve = 1.6f; //factor by which soft and hard hits vary
const uint16_t thresh_margin = 100; //buffer
const uint16_t max_hit = 3000;
const uint32_t peak_time_frame_US = 2500; 
const uint32_t min_time_frame_MS = 60; //minimum time frame between hits
// (prevents chaotic sounds or input errors)
const uint8_t led_brightness = 40; //set LED brightness 
const uint32_t special_window_MS =  8000; //time period for pads being hit 
//for special effect
const uint8_t combo_len =4; //combination length is 4 for special effect
const uint8_t combo[combo_len]={0,1,2,3}; //hitting order for combo effect

//check print
#define check_print 1
struct Sound{const int16_t*data;uint32_t len;};
struct Voice {const int16_t*data;uint32_t len; uint32_t pos; int32_t gain; 
    bool active;bool keep;};
const uint8_t special = 4; //special sound is at no 4 in sounds
Sound sounds[5];
Voice voices[max_voice];
portMUX_TYPE voiceMux = portMUX_INITIALIZER_UNLOCKED;
I2SClass i2s;

void play_sound(uint8_t index, uint8_t vel){
    Sound& s = sounds[index];
    if(!s.data) return; //if not sound data it returns or exits
    float level = powf(vel/255.0f,velocity_curve); //scales between 0.0-1.0
    //for audio output
    int32_t gain = (int32_t)(level*master_vol*256.0f/100.0f); //final volume gain
    portENTER_CRITICAL(&voiceMux); int slot = -1;// Voice channel slot used finds
    uint32_t oldest = 0; //variable to track oldest voice
    for (int i = 0;i< max_voice;i++){   //looks for free voice slot
    if (!voices[i].active){slot=i;break;} //free slot 
    if (!voices[i].keep && voices [i].pos <=oldest){
        oldest =voices[i].pos;slot =i;}} //if no free slot
    portEXIT_CRITICAL(&voiceMux);}

bool anyVoiceActive(){
    bool any=false;// Flag to track voices if found
    portENTER_CRITICAL(&voiceMux);
    for (int i = 0;i<max_voice;i++)if (voices[i].active)any=true;
    portEXIT_CRITICAL(&voiceMux);return any;} //if any active sound is found stops checking
    //returns true or false


void audioTask(void*){
    const int frames = 128;static int16_t buf[frames*2]; for (;;){
        portENTER_CRITICAL(&voiceMux);
        for (int i = 0;i< frames;i++){
            int32_t acc = 0;
            for (int v = 0;v< max_voice;v++){ //loop over active voices
                Voice& vo = voices[v];
                if(!vo.active) continue; //skips inactive ones
                acc += ((int32_t)vo.data[vo.pos]*vo.gain)>>8;
                if(++vo.pos>=vo.len)vo.active=false;} //disable when done
                if(acc>32767) acc = 32767;
                if(acc<-32768)acc = -32768; //signal within limits onlyy
                buf[2*i]= buf[2*i+1]= (int16_t)acc;}
                //same sound on left and right channels (mono to stereo)
                portEXIT_CRITICAL(&voiceMux);
                i2s.write((uint8_t*)buf,sizeof(buf));}} //sends data to the I2S amp module

Adafruit_NeoPixel strip(48,LED_pin,NEO_GRB + NEO_KHZ800);//48 AS 4 LEDS WITH 12 IN EACH
const uint8_t PAD_RGB[4][3]={{255,0,0},{0,255,0},{0,80,255},{255,150,0}};
//SETS COLORS RED,GREEN,BLUE AND ORANGE USING RBG
float ledLevel[4]= {0,0,0,0};//brightness of each led
uint32_t lastLEDMs = 0; //time
bool ledsWereLit = false; //sets flag to false cuz else it glow even when idle
uint32_t specialUnitMs = 0; //time for special effect

void flashRing(uint8_t pad, uint8_t vel){
    if (pad >= 4)return;
    float intensity = vel / 255.0f; //finds intensity between 0.0-1.1 
    if (intensity < 0.3f) {intensity = 0.3f;} //sets minimum intensity to 0.3 units
    ledLevel[pad]= intensity;} //sets light intensity

void updateleds(){
    if (millis()- lastLEDMs < 20)return; //RUN LOOP ONLY EVERY 20 MS
    lastLEDMs = millis();
    if((int32_t)(specialUnitMs - lastLEDMs)>0){ //Rainbow animation 
        uint16_t hue = (uint16_t)(lastLEDMs*24); for (uint8_t i=0;i<48;i++)
        strip.setPixelColor(i,strip.gamma32(strip.ColorHSV(hue + i *2048)));
        strip.show(); //shows rainbow
        ledsWereLit = true; //makes flag true,shows its active
        return;}
    bool anyLit = false;
    for (uint8_t p = 0;p<4;p++){
        ledLevel[p]*= 0.85f;//reduce brightness level by 15% each frame
        if (ledLevel[p]< 0.02f)ledLevel[p]=0; //clean values
        if (ledLevel[p]> 0)anyLit = true;
        uint32_t c = strip.Color(PAD_RGB[p][0]* ledLevel[p],PAD_RGB[p][1]
            *ledLevel[p],PAD_RGB[p][2] *ledLevel[p]); 
        //scales the pad color (red, blue green or orange by brightness)
        for (uint8_t k= 0;k<12;k++) //12 LED's
        strip.setPixelColor(p *12+k,c);}
if (anyLit||ledsWereLit)strip.show();
    ledsWereLit =anyLit;} //updates tracking and markers

enum PadState: uint8_t {idle,peaking,locked}; //STATES DEFINED 
struct Pad {PadState state; uint16_t thresh;uint16_t peak;uint32_t t0;};
//sensor state,threashold, peak timestamp
Pad pads[4];
uint8_t comboStep = 0; //current steo in combo
uint32_t combostartMS = 0; //when combo started
bool comboCheck(uint8_t pad){
    uint32_t now=millis();
    if (comboStep > 0 && now- combostartMS > special_window_MS) comboStep = 0; //too slow so starts over 
    if (pad == combo[comboStep]){ 
    if (comboStep == 0) combostartMS = now;
    if (++comboStep == combo_len){comboStep = 0;return true;}}//detects combo,
      return false;}
        //if combo then resets combo mechanism,else resets count to 1 if no combo

void onhit(uint8_t p, uint16_t peak){
    uint8_t vel = 255;
    if(pads[p].thresh < max_hit){ // Map raw piezo peak amplitude relative to calibration threshold
        uint16_t pk = peak > max_hit ? max_hit : peak;
    vel = map(pk, pads[p].thresh, max_hit, 10, 255);}
  if (comboCheck(p)) { // Check if hit completes combo
    play_sound(special, 255); //plays audio sample at full volume
    specialUnitMs = millis() + (uint32_t) //tiem for combo
    ((uint64_t)sounds[special].len * 1000ULL/sample_freq);
    #if check_print
    Serial.printf("pad%u peak%u velocity% u\n",p+1, peak,vel);
    #endif
  }}
    void caliberate(){
        uint16_t idlemax[4]={0,0,0,0};
        uint32_t end = millis()+ 500;// Sample background noise
        //// Track base noise floor across all 4 piezo inputs
        while (millis()< end){
            for (uint8_t p= 0; p<4;p++){
                uint16_t v = analogRead(Piezo_pin[p]);
                if (v>idlemax[p])idlemax[p] =v;}
                delayMicroseconds(200);} 
            for (uint8_t p = 0; p<4;p++){//sets threasholds above base noise
                pads[p] ={idle,(uint16_t)(idlemax[p]+thresh_margin),0,0};
        #if check_print
        Serial.printf("pad%u idle max %u-> threshold%u\n",p+1,idlemax[p],pads[p].thresh);
        #endif
    }}

    void selfTest(){
        for (uint8_t p = 0;p<4;p++){
            play_sound(p,200); //test audio on turning on
            flashRing(p,200);//test led
            uint32_t t= millis();
            while (millis()-t<450){updateleds();delay(1);}}}

    void setup(){
        Serial.begin(115200);
        Serial.setRxTimeout(0); //no pause if computer connected
        strip.begin();
        strip.setBrightness(led_brightness); //LED limit 
        strip.clear();
        strip.show();
        analogReadResolution(12); // Configuring Piezo pins to audio
        for (uint8_t p=0;p<4;p++){
            pinMode(Piezo_pin[p],INPUT);
            analogSetPinAttenuation(Piezo_pin[p],ADC_11db);}
        //loading sounds to corresponding pad numbers
        sounds[0]={kick_data,kick_len}; //pad1
        sounds[1]={hi_hat_data,hi_hat_len};//pad2
        sounds[2]={snare_data,snare_len};//pad3
        sounds[3]={tom_data,tom_len};//pad4
        sounds[4]={special_effect_data,special_len};//comboooo

        i2s.setPins(I2S_SLCK,I2S_LRCK,I2S_SD);
        if(!i2s.begin(I2S_MODE_STD,sample_freq,I2S_DATA_BIT_WIDTH_16BIT,
        I2S_SLOT_MODE_STEREO,I2S_STD_SLOT_BOTH)){
            Serial.println("I2S start failed - check pins");
            while(true)delay(1000);} //checks amplifier module, if sumn wrong does not play
            xTaskCreatePinnedToCore(audioTask, "audio",6144,nullptr,4,nullptr,0);
        
        selfTest(); //runs test
        uint32_t t0 = millis();
        while (anyVoiceActive()&&millis()-t0 < 4000){
            updateleds();delay(10);}
            delay(300);Serial.println("Calibrating - do not touch the pads");
            caliberate(); //this calibrates the pads
            Serial.println("Ready");}

void loop(){
    for(uint8_t p=0;p<4;p++){uint16_t v = analogRead(Piezo_pin[p]);
        Pad& pd = pads [p]; //loops through all 4 drum pads reads analog input
        //reference handle pd for pad data
        switch (pd.state){ 
            case idle: //default state or base state-wai for hit
            if (v> pd.thresh){pd.state = peaking;pd.peak = v,pd.t0=micros();}
            // If piezo input more than threshold there hit, it changes state
                break;
            case peaking: //max impact voltage on a hit
            if (v>pd.peak)pd.peak =v; // changes peak if input more than current
            if(micros()-pd.t0 >= peak_time_frame_US){ //within time frame only
                onhit(p,pd.peak);//final hit
                pd.state = locked;
                pd.t0 =millis();} //time to millis
                break;
            case locked: //reset time period it locked, no more hits
            if(millis()-pd.t0 >= min_time_frame_MS && v< pd.thresh)pd.state=idle;
            //once time has passed and voltage below threashold it changes to idle
            break;}}
            updateleds();} //LED lighting is updated to match audio output

